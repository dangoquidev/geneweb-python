[flake8]
max-line-length = 120
extend-ignore = E203, W503
# Ignorer des fichiers entiers
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    build,
    dist,
    *.egg-info,
    ../src/backend/geneweb/web/server.py,
    ../src/backend/geneweb/web/gwd_server.py,
    ../src/backend/geneweb/web/gwd_templates.py,
    ../src/backend/servers/gwd_simple.py,
    ../src/backend/servers/simple_server.py,
    ../src/backend/servers/gwd_templates.py,
